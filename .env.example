# Copy to .env and edit. All vars are optional; sensible defaults are built in.

# --- Server ---
TAJ_HOST=127.0.0.1
TAJ_PORT=8000

# --- What you're learning ---
# Options shipped: ar-LEV (Levantine Arabic), ar-MSA, zh-CN, ja-JP
TAJ_LANGUAGE=ar-LEV
TAJ_LEARNER_LEVEL=A1          # A1 A2 B1 B2 C1

# --- Tutor brain: cloud Claude (recommended, easiest) ---
# 1) pip install anthropic
# 2) paste your key below
# 3) set TAJ_LLM_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-paste-your-key-here
TAJ_CLAUDE_MODEL=claude-opus-4-8   # or claude-haiku-4-5 for faster/cheaper replies

# --- Providers: auto | mock | <name> ---
# Speech (stt/tts) runs in your BROWSER by default — leave these on auto/mock;
# they only matter if you want fully-offline local speech (needs Python 3.9-3.11).
# For the brain, "auto" uses Claude automatically if ANTHROPIC_API_KEY is set.
TAJ_STT_PROVIDER=auto          # browser speech is the default; auto | mock | whisper
TAJ_LLM_PROVIDER=claude        # claude | ollama | mock | auto
TAJ_TTS_PROVIDER=auto          # browser speech is the default; auto | mock | coqui

# --- faster-whisper (speech-to-text) ---
TAJ_WHISPER_MODEL=small       # tiny | base | small | medium | large-v3
TAJ_WHISPER_DEVICE=auto       # cpu | cuda | auto
TAJ_WHISPER_COMPUTE_TYPE=int8 # int8 (cpu) | float16 (gpu)

# --- Ollama (tutor brain) ---
TAJ_OLLAMA_URL=http://localhost:11434
TAJ_OLLAMA_MODEL=qwen2.5:7b-instruct

# --- Coqui XTTS (text-to-speech) ---
TAJ_COQUI_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
# TAJ_TTS_SPEAKER_WAV=./voices/taj_reference.wav   # optional voice cloning
